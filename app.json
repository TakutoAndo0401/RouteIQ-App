{
  "expo": {
    "name": "RouteIQ",
    "slug": "routeiq-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f6f4",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routeiq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "現在地を出発地に設定するために位置情報を利用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.routeiq.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地を出発地に設定するために位置情報を利用します。"
        }
      ]
    ],
    "scheme": "routeiq",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7e64fea0-434b-4c0e-a22b-2c5bd750bc8d"
      }
    }
  }
}
