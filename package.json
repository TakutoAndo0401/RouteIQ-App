{
  "name": "routeiq-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start",
    "android": "EXPO_OFFLINE=1 ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" NODE_OPTIONS='--dns-result-order=ipv4first' expo start --android --localhost",
    "ios": "EXPO_OFFLINE=1 NODE_OPTIONS='--dns-result-order=ipv4first' expo start --ios --localhost",
    "web": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "storybook": "pnpm storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true NODE_OPTIONS='--dns-result-order=ipv4first' expo start",
    "storybook:web": "pnpm storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true NODE_OPTIONS='--dns-result-order=ipv4first' expo start --web",
    "storybook:generate": "sb-rn-get-stories -c ./.storybook",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@expo/metro-runtime": "^4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.7",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@figma/code-connect": "^2.0.0",
    "@storybook/addon-ondevice-actions": "^10.6.0",
    "@storybook/addon-ondevice-controls": "^10.6.0",
    "@storybook/react-native": "^10.6.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.12",
    "expo-doctor": "^1.20.4",
    "expo-modules-autolinking": "~2.0.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@expo/dom-webview": "-",
    "@xmldom/xmldom": "^0.9.12",
    "decode-uri-component": "^0.5.0",
    "image-size": "2.0.4",
    "postcss": "^8.5.28",
    "react-native-gesture-handler": "~2.20.2",
    "uuid": "^11.1.1"
  },
  "packageManager": "pnpm@11.17.0",
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  }
}
